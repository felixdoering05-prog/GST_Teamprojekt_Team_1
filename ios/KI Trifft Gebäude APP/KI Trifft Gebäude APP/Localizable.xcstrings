    "Denselben Import erneut bestätigen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denselben Import erneut bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the same import again"
          }
        }
      }
    },
    "Der Code gilt 15 Minuten und nur einmal. Nach fünf falschen Eingaben benötigst du einen neuen Code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code gilt 15 Minuten und nur einmal. Nach fünf falschen Eingaben benötigst du einen neuen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is valid for 15 minutes and only once. After five wrong entries you need a new code."
          }
        }
      }
    },
    "Der E-Mail-Versand ist noch nicht eingerichtet. Bitte melde dich beim Projektteam. Es wurde keine E-Mail verschickt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der E-Mail-Versand ist noch nicht eingerichtet. Bitte melde dich beim Projektteam. Es wurde keine E-Mail verschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email delivery is not set up yet. Please contact the project team. No email was sent."
          }
        }
      }
    },
    "Der Mangel erscheint als Markierung im 3D-Modell.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mangel erscheint als Markierung im 3D-Modell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The defect appears as a marker in the 3D model."
          }
        }
      }
    },
    "Der Messwert konnte nicht geladen werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Messwert konnte nicht geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reading could not be loaded."
          }
        }
      }
    },
    "Der Name gilt für alle Mitglieder. Raum-ID und QR-Link bleiben gleich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name gilt für alle Mitglieder. Raum-ID und QR-Link bleiben gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name applies to all members. Room ID and QR link stay the same."
          }
        }
      }
    },
    "Der Projektserver erzeugt aus dem Scan ein IFC: Räume mit Namen und Fläche, Wände mit Stärke, Türen und Fenster als Öffnungen, Möbel. Ohne Verbindung entsteht der Entwurf auf dem iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Projektserver erzeugt aus dem Scan ein IFC: Räume mit Namen und Fläche, Wände mit Stärke, Türen und Fenster als Öffnungen, Möbel. Ohne Verbindung entsteht der Entwurf auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project server creates an IFC from the scan: rooms with name and area, walls with thickness, doors and windows as openings, furniture. Without a connection, the draft is created on the iPhone."
          }
        }
      }
    },
    "Der Raumname ist zunächst eine freie Zuordnung, keine automatisch erkannte IFC-Verknüpfung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raumname ist zunächst eine freie Zuordnung, keine automatisch erkannte IFC-Verknüpfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room name is a free assignment for now, not an automatically detected IFC link."
          }
        }
      }
    },
    "Der Sensor wird als Simulation angelegt. Es werden keine Messwerte erfunden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sensor wird als Simulation angelegt. Es werden keine Messwerte erfunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sensor is created as a simulation. No readings are made up."
          }
        }
      }
    },
    "Der Sprachdienst ist auf diesem Server gerade nicht eingerichtet. Der Textassistent funktioniert weiter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprachdienst ist auf diesem Server gerade nicht eingerichtet. Der Textassistent funktioniert weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice service is not set up on this server right now. The text assistant keeps working."
          }
        }
      }
    },
    "Der Standort wird für Wetter, Heatmap und Kartenumgebung verwendet und mit Mitgliedern des Gebäudes geteilt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird für Wetter, Heatmap und Kartenumgebung verwendet und mit Mitgliedern des Gebäudes geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location is used for weather, heat map and map surroundings and shared with the building's members."
          }
        }
      }
    },
    "Der Text wird durch einen Löschhinweis ersetzt. Die Aktion kann in der App nicht rückgängig gemacht werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird durch einen Löschhinweis ersetzt. Die Aktion kann in der App nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is replaced with a deletion note. This cannot be undone in the app."
          }
        }
      }
    },
    "Der ausgewählte Raum leuchtet im 3D-Modell passend zum bestätigten Gerätezustand. Mehrere Lampen werden als vereinfachte Mischfarbe dargestellt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Raum leuchtet im 3D-Modell passend zum bestätigten Gerätezustand. Mehrere Lampen werden als vereinfachte Mischfarbe dargestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected room lights up in the 3D model according to the confirmed device state. Several lamps are shown as a simplified mixed colour."
          }
        }
      }
    },
    "Der lokale Eintrag wird von diesem Gerät entfernt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Eintrag wird von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local entry is removed from this device."
          }
        }
      }
    },
    "Designmodus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Designmodus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "de": {
