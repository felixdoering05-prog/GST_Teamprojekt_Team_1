    },
    "Ein eigenes Gebäude kann einem Team zugeordnet werden. Bestehende Gebäudegruppen werden dadurch nicht automatisch angepasst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigenes Gebäude kann einem Team zugeordnet werden. Bestehende Gebäudegruppen werden dadurch nicht automatisch angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A building you own can be assigned to a team. Existing building groups are not adjusted automatically."
          }
        }
      }
    },
    "Ein und Aus ändern nur den simulierten Zustand auf dem Projektserver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein und Aus ändern nur den simulierten Zustand auf dem Projektserver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On and off only change the simulated state on the project server."
          }
        }
      }
    },
    "Eine Sensorkennung ordnet CSV-Zeilen zu. Es wird keine Hardware gekoppelt und es entstehen noch keine Messwerte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sensorkennung ordnet CSV-Zeilen zu. Es wird keine Hardware gekoppelt und es entstehen noch keine Messwerte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensor ID maps CSV rows. No hardware is paired and no readings are created yet."
          }
        }
      }
    },
