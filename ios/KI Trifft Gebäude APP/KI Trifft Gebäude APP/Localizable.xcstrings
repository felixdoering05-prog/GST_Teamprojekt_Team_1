    "Ausschalten sperrt neue KI-Anfragen. Bereits übermittelte Daten können dadurch nicht zurückgerufen werden. Die Live-Sprachfunktion ist in diesem Test-Build nicht verfügbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten sperrt neue KI-Anfragen. Bereits übermittelte Daten können dadurch nicht zurückgerufen werden. Die Live-Sprachfunktion ist in diesem Test-Build nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off blocks new AI requests. Data already sent cannot be recalled. Live voice is not available in this test build."
          }
        }
      }
