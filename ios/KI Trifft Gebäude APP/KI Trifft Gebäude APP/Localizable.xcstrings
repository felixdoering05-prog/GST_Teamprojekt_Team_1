            "value": "Open ${building}"
          }
        }
      }
    },
    "Öffne ein IFC-Modell aus der Dateien-App, zum Beispiel einen Export aus Revit. Du kannst es drehen, zoomen und Bauteile antippen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein IFC-Modell aus der Dateien-App, zum Beispiel einen Export aus Revit. Du kannst es drehen, zoomen und Bauteile antippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an IFC model from the Files app, for example an export from Revit. You can rotate, zoom and tap components."
          }
        }
      }
    },
    "Öffne ein IFC-Modell mit exportierten Räumen. Schalte das simulierte Licht pro Raum und sieh die Markierung im Modell. Keine Verbindung zu echten Lampen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein IFC-Modell mit exportierten Räumen. Schalte das simulierte Licht pro Raum und sieh die Markierung im Modell. Keine Verbindung zu echten Lampen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an IFC model with exported rooms. Switch the simulated light per room and see the highlight in the model. No connection to real lamps."
          }
        }
      }
    },
    "Öffne unten eine Gebäudemappe und lade deine IFC-Datei hoch. Danach erscheint dein Modell hier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne unten eine Gebäudemappe und lade deine IFC-Datei hoch. Danach erscheint dein Modell hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a building folder below and upload your IFC file. Your model then appears here."
          }
        }
      }
    },
    "Öffnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "Öffnet Nala, deine Gebäudeassistentin, mit deiner Frage. Gesendet wird erst, wenn du in der App auf Senden tippst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Nala, deine Gebäudeassistentin, mit deiner Frage. Gesendet wird erst, wenn du in der App auf Senden tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Nala, your building assistant, with your question. Nothing is sent until you tap Send in the app."
          }
        }
      }
    },
    "Öffnet die Raumortung im zuletzt geöffneten Gebäude.": {
      "localizations": {
        "de": {
