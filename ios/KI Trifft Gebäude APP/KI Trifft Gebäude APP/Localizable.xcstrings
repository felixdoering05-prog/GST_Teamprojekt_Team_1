            "state": "translated",
            "value": "Details"
          }
        }
      }
    },
    "Details / manuell korrigieren": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details / manuell korrigieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details / correct manually"
          }
        }
      }
    },
    "Details öffnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open details"
          }
        }
      }
    },
    "Die Adresse steht in Home Assistant unter Einstellungen → System → Netzwerk. Unterwegs funktioniert auch deine Home-Assistant-Cloud-Adresse (Nabu Casa).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse steht in Home Assistant unter Einstellungen → System → Netzwerk. Unterwegs funktioniert auch deine Home-Assistant-Cloud-Adresse (Nabu Casa)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address is in Home Assistant under Settings → System → Network. On the go, your Home Assistant Cloud address (Nabu Casa) also works."
          }
        }
      }
    },
    "Die Anzeige verwendet die Zeitzone deines iPhones. Gespeichert wird der genaue Zeitpunkt für alle Teammitglieder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzeige verwendet die Zeitzone deines iPhones. Gespeichert wird der genaue Zeitpunkt für alle Teammitglieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display uses your iPhone's time zone. The exact time is saved for all team members."
          }
        }
      }
    },
    "Die App gleicht Werte ab, wenn du sie öffnest. Für Werte rund um die Uhr kannst du stattdessen die Integration „Nala“ in Home Assistant installieren und mit einem Code koppeln.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App gleicht Werte ab, wenn du sie öffnest. Für Werte rund um die Uhr kannst du stattdessen die Integration „Nala“ in Home Assistant installieren und mit einem Code koppeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app syncs values when you open it. For values around the clock, you can instead install the “Nala” integration in Home Assistant and pair it with a code."
          }
        }
      }
    },
    "Die Dateiendung bleibt erhalten. Der neue Name gilt auch auf der Website.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateiendung bleibt erhalten. Der neue Name gilt auch auf der Website."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file extension is kept. The new name also applies on the website."
          }
        }
      }
    },
    "Die Eigentümerin oder der Eigentümer schaltet sie im Profil unter „WLAN-Präsenz (RuView)“ ein. Die Brücke für die ESP32-Knoten wird im Web unter Sensorik eingerichtet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner turns it on in the profile under “Wi-Fi presence (RuView)”. The bridge for the ESP32 nodes is set up on the web under Sensors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eigentümerin oder der Eigentümer schaltet sie im Profil unter „WLAN-Präsenz (RuView)“ ein. Die Brücke für die ESP32-Knoten wird im Web unter Sensorik eingerichtet."
          }
        }
      }
    },
    "Die Einfärbung zeigt illustrative Oberflächentemperaturen aus Wetter, Sonneneinstrahlung und Flächenausrichtung – keine gemessenen Raumtemperaturen, keine echten Materialien, keine Verschattungsprüfung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einfärbung zeigt illustrative Oberflächentemperaturen aus Wetter, Sonneneinstrahlung und Flächenausrichtung – keine gemessenen Raumtemperaturen, keine echten Materialien, keine Verschattungsprüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colouring shows illustrative surface temperatures from weather, solar radiation and surface orientation – no measured room temperatures, no real materials, no shading check."
          }
        }
      }
    },
    "Die Home-Assistant-Anmeldung liegt nur auf dem iPhone, mit dem verbunden wurde.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Home-Assistant-Anmeldung liegt nur auf dem iPhone, mit dem verbunden wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home Assistant sign-in is stored only on the iPhone that connected."
          }
        }
      }
    },
    "Die Modellgenerierung ist auf diesem Server noch nicht verfügbar. Deine Pläne bleiben gespeichert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellgenerierung ist auf diesem Server noch nicht verfügbar. Deine Pläne bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model generation is not available on this server yet. Your plans stay saved."
          }
        }
      }
    },
    "Die Person bekommt eine Einladung für das Gebäude und erscheint nach Annahme im Team. Die Rolle legst du danach unter Gebäude fest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person bekommt eine Einladung für das Gebäude und erscheint nach Annahme im Team. Die Rolle legst du danach unter Gebäude fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person gets an invitation to the building and appears in the team after accepting. You then set the role under Buildings."
          }
        }
      }
    },
    "Die Sonne ist untergegangen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne ist untergegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun has set."
          }
        }
      }
    },
    "Die Testadresse kann sich ändern. Hier lässt sie sich aktualisieren.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testadresse kann sich ändern. Hier lässt sie sich aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test address may change. You can update it here."
          }
        }
      }
    },
    "Die Zuordnung gilt für alle Personen, mit denen dieses Gebäude geteilt ist. Bereits gespeicherte Messwerte behalten ihren bisherigen Raum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zuordnung gilt für alle Personen, mit denen dieses Gebäude geteilt ist. Bereits gespeicherte Messwerte behalten ihren bisherigen Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assignment applies to everyone this building is shared with. Readings already saved keep their previous room."
          }
        }
      }
    },
    "Die ausgewählten Rollen ersetzen bestehende Einzelrollen. Der Server prüft jedes Gebäude und jeden Rang vor dem Speichern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Rollen ersetzen bestehende Einzelrollen. Der Server prüft jedes Gebäude und jeden Rang vor dem Speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected roles replace existing individual roles. The server checks every building and rank before saving."
          }
        }
      }
    },
    "Die bereits übertragene Meldung bleibt auf dem Server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bereits übertragene Meldung bleibt auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report already sent stays on the server."
          }
        }
      }
    },
    "Die echte Lampe bleibt nur für dein freigegebenes Konto bedienbar. Andere Gebäudemitglieder erhalten dadurch keinen Zugriff auf dein Zuhause.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die echte Lampe bleibt nur für dein freigegebenes Konto bedienbar. Andere Gebäudemitglieder erhalten dadurch keinen Zugriff auf dein Zuhause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The real lamp can only be controlled by your authorised account. Other building members get no access to your home through this."
          }
        }
      }
    },
    "Die gelaufene Strecke passt nicht zum Abstand im Plan (Faktor %@). Bitte neu ausrichten und die Punkte genauer antippen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gelaufene Strecke passt nicht zum Abstand im Plan (Faktor %@). Bitte neu ausrichten und die Punkte genauer antippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distance walked does not match the distance on the plan (factor %@). Please align again and tap the points more precisely."
          }
        }
      }
    },
    "Die im Web-Dashboard importierten Energiezeiträume dieses Gebäudes erscheinen auch hier. Der CSV-Import auf dem iPhone unterstützt zunächst Sensormessungen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die im Web-Dashboard importierten Energiezeiträume dieses Gebäudes erscheinen auch hier. Der CSV-Import auf dem iPhone unterstützt zunächst Sensormessungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy periods imported for this building in the web dashboard also appear here. CSV import on the iPhone supports sensor readings for now."
          }
        }
      }
    },
    "Diese Angaben sind getrennt von deinem Login und nur für Teammitglieder gedacht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben sind getrennt von deinem Login und nur für Teammitglieder gedacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These details are separate from your login and meant only for team members."
          }
        }
      }
    },
    "Dieselben Projekt-Grenzwerte wie auf der Website. Diese Auswertung läuft ohne Gemini und ist keine bestätigte Gebäudediagnose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Projekt-Grenzwerte wie auf der Website. Diese Auswertung läuft ohne Gemini und ist keine bestätigte Gebäudediagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same project thresholds as on the website. This analysis runs without Gemini and is not a confirmed building diagnosis."
          }
        }
      }
    },
    "Diesem Raum sind noch keine Geräte zugeordnet. Unter Geräte → „Gebäude & Raum“ kannst du Lampen diesem IFC-Raum zuordnen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Raum sind noch keine Geräte zugeordnet. Unter Geräte → „Gebäude & Raum“ kannst du Lampen diesem IFC-Raum zuordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices are assigned to this room yet. Under Devices → “Building & room” you can assign lamps to this IFC room."
          }
        }
      }
    },
    "Diesem Team sind noch keine Gebäude zugeordnet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Team sind noch keine Gebäude zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No buildings are assigned to this team yet."
          }
        }
      }
    },
    "Dieser Verlauf ist privat für dein Konto und wird auf dem Projektserver gespeichert. Bestätigte Modelländerungen sieht das Gebäudeteam. Es wird kein eigenes KI-Modell trainiert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Verlauf ist privat für dein Konto und wird auf dem Projektserver gespeichert. Bestätigte Modelländerungen sieht das Gebäudeteam. Es wird kein eigenes KI-Modell trainiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This history is private to your account and saved on the project server. The building team sees confirmed model changes. No AI model of our own is trained."
          }
        }
      }
    },
    "Dieses Gebäude hat noch keine Räume. Räume entstehen zum Beispiel aus einem IFC-Modell oder einem Raumscan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gebäude hat noch keine Räume. Räume entstehen zum Beispiel aus einem IFC-Modell oder einem Raumscan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This building has no rooms yet. Rooms come, for example, from an IFC model or a room scan."
          }
        }
      }
    },
    "Dieses Gebäude ist für dein Konto nicht freigegeben.": {
      "localizations": {
