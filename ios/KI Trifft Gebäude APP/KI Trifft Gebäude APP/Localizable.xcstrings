          }
        }
      }
    },
    "Mit einem Raumnamen kannst du sofort beginnen. Für die farbige Anzeige im 3D-Modell verknüpfe später einen vorhandenen IFC-Raum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Raumnamen kannst du sofort beginnen. Für die farbige Anzeige im 3D-Modell verknüpfe später einen vorhandenen IFC-Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start right away with a room name. For coloured display in the 3D model, link an existing IFC room later."
          }
        }
      }
    },
