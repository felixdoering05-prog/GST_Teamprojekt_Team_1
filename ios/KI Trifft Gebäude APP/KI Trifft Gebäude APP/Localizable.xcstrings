          "stringUnit": {
            "state": "translated",
            "value": "Lege Heizungswartung, Rauchmelder, Dachrinne & Co. an. Nala erinnert dich, wenn etwas fällig wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add heating maintenance, smoke detectors, gutters and more. Nala reminds you when something is due."
          }
        }
      }
    },
