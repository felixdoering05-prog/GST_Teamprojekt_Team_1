    "20 KI-Anfragen je Konto in 24 Stunden. Es gibt in diesem Build keine Live-Sprache und keine gestreamte Antwort; der Server liefert die Antwort vollständig zurück.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "20 KI-Anfragen je Konto in 24 Stunden. Es gibt in diesem Build keine Live-Sprache und keine gestreamte Antwort; der Server liefert die Antwort vollständig zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 AI requests per account in 24 hours. This build has no live voice and no streamed answer; the server returns the complete answer."
          }
        }
      }
