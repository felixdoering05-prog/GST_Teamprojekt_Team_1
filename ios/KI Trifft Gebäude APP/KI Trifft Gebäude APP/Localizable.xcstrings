    },
    "Übernehmen legt eine zusätzliche IFC-Datei in der Gebäudemappe an. Sieben Tage Zeit zur Prüfung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernehmen legt eine zusätzliche IFC-Datei in der Gebäudemappe an. Sieben Tage Zeit zur Prüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying adds an additional IFC file to the building folder. Seven days to review."
          }
        }
      }
    },
    "Übernehmen und Modell neu bauen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernehmen und Modell neu bauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply and rebuild model"
          }
        }
      }
    },
    "Übernimm Sensorwerte, Geräte und Bereiche aus deinem Home Assistant. Du meldest dich einfach mit deinem Home-Assistant-Konto an – nichts installieren, nichts kopieren.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm Sensorwerte, Geräte und Bereiche aus deinem Home Assistant. Du meldest dich einfach mit deinem Home-Assistant-Konto an – nichts installieren, nichts kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import sensor values, devices and areas from your Home Assistant. You simply sign in with your Home Assistant account – nothing to install, nothing to copy."
          }
        }
      }
    },
    "Übernommen werden nur Sensoren für Temperatur, Luftfeuchte, CO₂, Leistung und Energie, Werte nur von ausgewählten Sensoren. Personen, Standorte, Kameras und Anwesenheit bleiben in Home Assistant. Deine Home-Assistant-Anmeldung bleibt auf diesem iPhone; auf dem Projektserver liegt kein Home-Assistant-Zugang. Werte werden 90 Tage gespeichert und sind für Mitglieder dieses Gebäudes sichtbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernommen werden nur Sensoren für Temperatur, Luftfeuchte, CO₂, Leistung und Energie, Werte nur von ausgewählten Sensoren. Personen, Standorte, Kameras und Anwesenheit bleiben in Home Assistant. Deine Home-Assistant-Anmeldung bleibt auf diesem iPhone; auf dem Projektserver liegt kein Home-Assistant-Zugang. Werte werden 90 Tage gespeichert und sind für Mitglieder dieses Gebäudes sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only sensors for temperature, humidity, CO₂, power and energy are imported, and values only from selected sensors. People, locations, cameras and presence stay in Home Assistant. Your Home Assistant sign-in stays on this iPhone; the project server holds no Home Assistant access. Values are stored for 90 days and are visible to members of this building."
          }
        }
      }
    },
    "Übernommen werden nur Sensoren für Temperatur, Luftfeuchte, CO₂, Leistung und Energie. Welche, wählst du im nächsten Schritt aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernommen werden nur Sensoren für Temperatur, Luftfeuchte, CO₂, Leistung und Energie. Welche, wählst du im nächsten Schritt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only sensors for temperature, humidity, CO₂, power and energy are imported. You choose which in the next step."
          }
        }
      }
    },
