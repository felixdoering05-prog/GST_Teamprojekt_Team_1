{
  "name": "Sensor",
  "type": "object",
  "properties": {
    "sensor_code": {
      "type": "string",
      "description": "Lesbarer Zeichenschlüssel: Gebäude-Geschoss-Raum-Anlage-Funktion-Typ"
    },
    "name": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string",
      "description": "Zugeordneter Raum; leer bedeutet keinem Raum zugeordnet"
    },
    "asset_number": {
      "type": "string",
      "description": "Anlagennummer im Zeichenschlüssel"
    },
    "function_key": {
      "type": "string",
      "description": "Funktionskürzel im Zeichenschlüssel"
    },
    "asset_type": {
      "type": "string",
      "description": "Anlagentyp-Kürzel im Zeichenschlüssel"
    },
    "metric": {
      "type": "string",
      "enum": [
        "temperature",
        "co2",
        "humidity"
      ],
      "description": "Messgröße: Temperatur, CO₂ oder Luftfeuchte"
    },
    "unit": {
      "type": "string",
      "description": "Messeinheit, z. B. °C, ppm, %"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktiv",
        "inaktiv",
        "defekt"
      ],
      "default": "aktiv"
    },
    "hardware_type": {
      "type": "string",
      "description": "Sensortyp / Gerät"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vorgesehene Anbindung, z. B. csv, api, bacnet"
    },
    "position_note": {
      "type": "string",
      "description": "Einbauort / Position im Raum"
    },
    "installed_date": {
      "type": "string",
      "description": "Inbetriebnahme"
    },
    "last_calibration": {
      "type": "string",
      "description": "Letzte Kalibrierung"
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "real"
      ],
      "default": "demo"
    }
  },
  "required": [
    "sensor_code",
    "metric"
  ]
}
