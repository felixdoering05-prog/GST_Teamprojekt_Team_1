{
  "name": "Building",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Bezeichnung des Gebäudes, z. B. D21"
    },
    "code": {
      "type": "string",
      "description": "Kurzzeichen des Gebäudes"
    },
    "site": {
      "type": "string",
      "description": "Standort / Campus"
    },
    "address": {
      "type": "string",
      "description": "Adresse"
    },
    "year_built": {
      "type": "number",
      "description": "Baujahr"
    },
    "gross_area_m2": {
      "type": "number",
      "description": "Bruttogrundfläche in m²"
    },
    "floors_count": {
      "type": "number",
      "description": "Anzahl Geschosse"
    },
    "usage_type": {
      "type": "string",
      "description": "Hauptnutzung"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung"
    },
    "bim_model_ref": {
      "type": "string",
      "description": "Verweis auf das Revit-/IFC-Modell (Datei oder Modell-URL)"
    },
    "bim_status": {
      "type": "string",
      "enum": [
        "nicht_verknuepft",
        "vorbereitet",
        "verknuepft"
      ],
      "default": "vorbereitet",
      "description": "Stand der Revit-/IFC-Verknüpfung"
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "real"
      ],
      "default": "demo",
      "description": "Kennzeichnung: Demo-Datensatz oder reale Daten"
    },
    "latitude": {
      "type": "number",
      "description": "Breitengrad des Gebäudemittelpunkts (WGS84)"
    },
    "longitude": {
      "type": "number",
      "description": "Längengrad des Gebäudemittelpunkts (WGS84)"
    },
    "model_heading_degrees": {
      "type": "number",
      "description": "Modellrichtung im Uhrzeigersinn ab Norden (0–360°)"
    },
    "map_provider_consent": {
      "type": "boolean",
      "default": false,
      "description": "Freigabe zum Laden von OpenStreetMap-Kartenkacheln für diesen Gebäudestandort"
    }
  },
  "required": [
    "name"
  ]
}
