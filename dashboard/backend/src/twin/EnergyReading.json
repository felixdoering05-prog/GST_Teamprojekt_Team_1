{
  "name": "EnergyReading",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string"
    },
    "meter_code": {
      "type": "string",
      "description": "Z\u00e4hlerkennung"
    },
    "medium": {
      "type": "string",
      "enum": [
        "strom",
        "waerme",
        "kaltwasser",
        "warmwasser",
        "wasser",
        "gas",
        "pv_erzeugung",
        "netzbezug",
        "eigenverbrauch",
        "einspeisung",
        "co2"
      ],
      "description": "Energieart"
    },
    "value": {
      "type": "number",
      "description": "Verbrauch im Zeitraum"
    },
    "unit": {
      "type": "string",
      "description": "z. B. kWh, m\u00b3"
    },
    "period_start": {
      "type": "string",
      "description": "Beginn des Ablesezeitraums (ISO 8601)"
    },
    "period_end": {
      "type": "string",
      "description": "Ende des Ablesezeitraums (ISO 8601)"
    },
    "source": {
      "type": "string",
      "enum": [
        "demo",
        "real"
      ],
      "default": "demo"
    },
    "note": {
      "type": "string"
    },
    "meter_name": { "type": "string" },
    "meter_reading": { "type": "number" },
    "meter_level": { "type": "string", "enum": ["main", "sub"] },
    "unit_id": { "type": "string" },
    "unit_name": { "type": "string" },
    "reading_date": { "type": "string" },
    "cost_eur": { "type": "number" },
    "capture_method": { "type": "string", "enum": ["manual", "csv", "building_pass"] }
  },
  "required": [
    "medium",
    "value",
    "source"
  ]
}
