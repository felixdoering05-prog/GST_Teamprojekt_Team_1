FROM node:22-bookworm-slim AS node
FROM ubuntu:24.04 AS bimcraft
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN case "$TARGETARCH" in arm64) arch=aarch64; sum=a94d598d821b1da3366e6655147d318991a5a542c298da263f1fb97cc704d4c1;; amd64|'') arch=x86_64; sum=932a7c6c16bc3328b508b723f664760814bb23e03603f05a46da68eeef1e2341;; *) exit 1;; esac && \
 curl -fL --proto '=https' --retry 3 "https://github.com/IPedrax/BIMCraft/releases/download/v0.11.0/bimcraft-0.11.0-linux-${arch}.tar.gz" -o /tmp/bimcraft.tar.gz && \
 echo "$sum  /tmp/bimcraft.tar.gz" | sha256sum -c - && mkdir -p /opt/bimcraft && tar -xzf /tmp/bimcraft.tar.gz -C /opt/bimcraft --strip-components=1 && rm /tmp/bimcraft.tar.gz
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/ /usr/local/
COPY --from=bimcraft /opt/bimcraft /opt/bimcraft
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
ENV BIMCRAFT_NO_UPDATE_CHECK=1 HOME=/tmp NODE_OPTIONS=--max-old-space-size=256
USER 65534:65534
CMD ["node","src/plan-conversion/worker.js"]
