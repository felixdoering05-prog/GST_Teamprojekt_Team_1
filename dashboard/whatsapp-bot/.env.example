# Dedicated second number only. Register it in WhatsApp and join the project group first.
GITHUB_REPOSITORY=felixdoering05-prog/GST_Teamprojekt_Team_1
# Public repository: no GitHub token needed. Never paste a token into this file in GitHub.
GITHUB_TOKEN=
# Leave false for the public project repository. Private data requires a separate explicit decision.
ALLOW_PRIVATE_REPOSITORY=false
POLL_SECONDS=300
# Preview is the default. Set true only after reviewing the group ID and recipients.
SEND_ENABLED=false
WHATSAPP_GROUP_ID=
# Required for WhatsApp: existing, separately installed and updated Chrome/Chromium executable.
CHROME_PATH=
