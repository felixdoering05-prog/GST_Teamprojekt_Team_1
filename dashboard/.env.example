DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Optionaler Versand von Passwort-Codes. Ohne Einrichtung deaktiviert.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
MAIL_FROM=
# Kennwort und Reset-Schlüssel stehen ausschließlich in private-mail/.

# Optional Gemini assistant (credentials are a separate private file)
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
D21_AI_CONFIG_DIR=./private-ai

# Verwaltungsportal: IDs bestehender Administratorkonten, keine automatische Freigabe.
D21_ADMIN_USER_IDS=
D21_ADMIN_STATUS_DIR=./private-admin

# Optional D21 original IFC. Existing building ownership/accepted sharing controls access.
D21_CAMPUS_BUILDING_ID=
D21_CAMPUS_MODELS_DIR=./private-models

# Optional ElevenLabs. API-Key ausschließlich als geschützte Datei ablegen.
ELEVENLABS_ENABLED=false
ELEVENLABS_VOICE_ID=
D21_VOICE_CONFIG_DIR=./private-voice

# Private ElevenLabs Conversational AI agent (see ops/voice/live-agent.json)
ELEVENLABS_AGENT_ID=

# Private Home Assistant demo configuration and token; never commit contents
D21_HOMEASSISTANT_CONFIG_DIR=./private-homeassistant

# Optional: Pläne -> vorläufiger IFC-Entwurf; zusätzlich Gebäude-Opt-in erforderlich.
PLAN_CONVERSION_ENABLED=false
# Optional: only these server-configured account IDs bypass the personal 3/day quota.
# The shared 10/day and 3 pending jobs/account limits still apply.
PLAN_DAILY_QUOTA_EXEMPT_USER_IDS=

# Optional server-managed account IDs without daily AI/voice quotas. Provider limits still apply.
AI_CONVERSATION_UNLIMITED_USER_IDS=
